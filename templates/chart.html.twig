{% extends 'base.html.twig' %}

{% block title parent() ~ ' - ' ~ headline %}

{# The one control the site header carries here: which organization the chart is drawn for. #}
{% block header_action %}
    <div class="dropdown" {{ stimulus_controller('dropdown') }}>
        <button type="button" class="btn btn--secondary" aria-expanded="false" aria-haspopup="true"
                data-dropdown-target="toggle" data-action="dropdown#toggle">
            {{ organization.login|default(headline) }}
            <span class="btn__caret" aria-hidden="true">▾</span>
        </button>
        <ul class="dropdown__menu" data-dropdown-target="menu" hidden>
            <li>
                <a class="dropdown__item {{ organization is not defined ? 'is-disabled' }}"
                   href="{{ path('overview') }}">Most starred</a>
            </li>
            <li><hr class="dropdown__divider"></li>
            {% for owner in all_organizations() %}
                <li>
                    <a class="dropdown__item {{ owner.login == organization.login|default() ? 'is-disabled' }}"
                       href="{{ path('organization', {'organization': owner.login}) }}">
                        {{ owner.login }}
                    </a>
                </li>
            {% endfor %}
            <li><hr class="dropdown__divider"></li>
            <li><a class="dropdown__item" href="{{ path('start') }}">Add a repository</a></li>
        </ul>
    </div>
{% endblock %}

{% block content %}
    <main class="page" {{ stimulus_controller('swup', { containers: ['#nav', '#swup'] }) }}>
        <div id="swup" class="wrap page__body">
            <div class="eyebrow">{{ organization is defined ? 'Organization' : 'Overview' }}</div>
            <h1 class="chart-title">
                {{ headline }}
                {% if organization is defined %}
                    <a href="{{ organization.url }}" target="_blank" rel="noreferrer" class="chart-title__link"
                       title="{{ organization.url|replace({'https://':'', '/':''}) }}">
                        <i class="fas fa-arrow-up-right-from-square"></i>
                    </a>
                {% endif %}
            </h1>

            {#
             # A page waiting for a worker has to move on its own. Where the placeholder below is drawn it
             # polls the repository itself; everywhere else the status reloads the page now and then.
             #}
            {% set showSkeleton = pendingRepository|default(false) and not pendingRepository.hasData and repositories is empty %}

            {% if pendingRepository|default(false) %}
                <div class="alert alert--info section"
                     {% if not showSkeleton %}{{ stimulus_controller('refresh', {interval: 30000}) }}{% endif %}>
                    {% if pendingRepository.hasData %}
                        <strong>{{ pendingRepository.name }} is being analysed right now.</strong>
                        {{ pendingRepository.tags|length }} of its releases are measured so far - this page
                        updates itself as more of them come in.
                    {% else %}
                        <strong>{{ pendingRepository.name }} is queued for analysis.</strong>
                        Every release of it is checked out and measured one by one, which takes a while -
                        this page updates itself as soon as the first numbers are in.
                    {% endif %}
                </div>
            {% elseif organization is defined and repositories is empty %}
                <div class="alert alert--warning section">
                    None of the repositories of {{ organization.login }} carries a release that could be measured.
                </div>
            {% endif %}

            {#
             # A repository that was just submitted has a page before it has numbers: the shape of the
             # report is drawn as a placeholder, and the page swaps itself for the real thing as soon as
             # the worker measured the first release.
             #
             # Only when there is nothing else to draw, though - an organization that already carries
             # analysed repositories keeps its chart, and the alert above says what happens to the new one.
             #}
            {% if showSkeleton %}
                <div class="section skeleton"
                     {{ stimulus_controller('skeleton', { url: path('repository', {'id': pendingRepository.id}) }) }}>
                    <p class="chart-lead">
                        Waiting for the first measured release - this page updates itself as soon as there
                        is one.
                    </p>
                    <div class="panel chart-panel">
                        <div class="skeleton__chart" aria-hidden="true">
                            {% for height in [38, 62, 47, 71, 55, 84, 49, 66, 58, 77, 61, 90] %}
                                <span class="skeleton__bar" style="height: {{ height }}%"></span>
                            {% endfor %}
                        </div>
                    </div>
                    <section class="section">
                        <div class="eyebrow">Release analysis</div>
                        <div class="panel panel--pad-lg" style="margin-top: var(--space-5)">
                            <div class="analysis" aria-hidden="true">
                                {% for group in 1..4 %}
                                    <div>
                                        <div class="analysis__title">
                                            <span class="skeleton__line" style="width: 40%"></span>
                                        </div>
                                        <dl class="analysis__list">
                                            {% for row in 1..3 %}
                                                <div class="analysis__row">
                                                    <dt class="analysis__label">
                                                        <span class="skeleton__line" style="width: {{ 90 + row * 20 }}px"></span>
                                                    </dt>
                                                    <dd class="analysis__value">
                                                        <span class="skeleton__line" style="width: 56px"></span>
                                                    </dd>
                                                </div>
                                            {% endfor %}
                                        </dl>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </section>
                </div>
            {% elseif repositories is not empty %}
                <div data-controller="chart"
                     data-chart-limit-value="8"
                     data-repositories="{{ selectedRepositories|map(repository => repository.asGraph)|json_encode|e('html_attr') }}">
                    <p class="chart-lead">
                        Average cyclomatic complexity per analysed release.
                        <span data-chart-target="seriesCount"></span>
                    </p>

                    <div class="panel chart-panel">
                        <div class="chart-canvas">
                            <canvas data-chart-target="canvas"></canvas>
                        </div>
                    </div>

                    <section class="section" data-chart-target="release" hidden>
                        <div class="release-head">
                            <div>
                                <div class="eyebrow">Release analysis</div>
                                <h2>
                                    <span class="release-head__name" data-chart-target="releaseRepository"></span>
                                    <span class="badge" data-chart-target="releaseName"></span>
                                </h2>
                                <div class="release-head__meta" data-chart-target="releaseMeta"></div>
                            </div>
                            <select class="release-select" aria-label="Release"
                                    data-chart-target="releaseSelect" data-action="chart#selectRelease"></select>
                        </div>
                        <div class="panel panel--pad-lg">
                            <div class="analysis" data-chart-target="analysis"></div>
                        </div>
                    </section>

                    <div class="section repository-picker">
                        <div class="eyebrow">Repositories</div>
                        <select class="js-repository-select" name="repositories[]" multiple="multiple"
                                data-chart-target="select">
                            {# no whitespace around the name: select2 renders the raw text into its chips #}
                            {% for repository in repositories %}
                                <option value="{{ repository.id }}" {{ repository in selectedRepositories ? 'selected="selected"' }}>{{ repository.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            {% endif %}
        </div>
    </main>
{% endblock %}
