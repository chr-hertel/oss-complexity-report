{% extends 'base.html.twig' %}

{% block title parent() ~ ' - ' ~ headline %}

{% block content %}
    <main {{ stimulus_controller('swup', { containers: ['#nav', '#swup'] }) }}>
        <div class="bg-white p-3 shadow-lg">
            <div class="container d-flex justify-content-between">
                <a class="logo" href="{{ path('start') }}">
                    <h2 class="mb-0">Open Source PHP Software</h2>
                    <h1 class="mb-0">Complexity Report</h1>
                </a>
                <div id="nav" class="dropdown btn-group-lg mt-2">
                    <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                        {{ project.name|default(headline) }}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right overflow-auto" style="max-height: 70vh" aria-labelledby="dropdownMenuButton">
                        <li>
                            <a class="dropdown-item {{ project is not defined ? 'disabled' }}" href="{{ path('overview') }}">Most starred</a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        {% for vendor in all_projects() %}
                            <li>
                                <a class="dropdown-item {{ vendor.vendor == project.vendor|default() ? 'disabled' }}"
                                   href="{{ path('project', {'vendor': vendor.vendor}) }}">
                                    {{ vendor.name }}
                                </a>
                            </li>
                        {% endfor %}
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('start') }}">Add a repository</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div id="swup" class="js-project container mt-5">
            <h2 class="mb-0">{{ headline }}
                {% if project is defined %}
                    <a href="{{ project.url }}" target="_blank" class="text-secondary"
                       title="{{ project.url|replace({'https://':'', '/':''}) }}">
                        <i class="fas fa-external-link-square-alt h6"></i>
                    </a>
                {% endif %}
            </h2>
            <div data-controller="chart"
                 data-repositories="{{ selectedRepositories|map(repository => repository.asGraph)|json_encode|e('html_attr') }}">
                <canvas id="canvas" class="img-fluid"></canvas>
                <div class="form-group mx-3 my-4">
                    <h3>Repositories</h3>
                    <select class="js-repository-select form-control" name="repositories[]" multiple="multiple">
                        {% for repository in repositories %}
                            <option value="{{ repository.id }}" {{ repository in selectedRepositories ? 'selected="selected"' }}>{{ repository.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
