{% extends 'base.html.twig' %}

{% block title parent() ~ ' - ' ~ selection.headline %}

{% block content %}
    {#
     # The one chart of the report. What it is called follows from what is in it: a single repository, the
     # account everything in it belongs to, or a comparison someone put together.
     #}
    <main class="page">
        <div class="wrap page__body">
            {% set series = selection.series %}
            {% set waiting = selection.waiting %}
            {# nothing to draw and something on its way: the shape of the report stands in for it #}
            {% set showSkeleton = series is empty and waiting is not empty %}

            <div class="eyebrow">{{ selection.eyebrow }}</div>
            <h1 class="chart-title">
                {{ selection.headline }}
                {% if selection.url %}
                    <a href="{{ selection.url }}" target="_blank" rel="noreferrer" class="chart-title__link"
                       title="{{ selection.url|replace({'https://':''}) }}">
                        <i class="fas fa-arrow-up-right-from-square"></i>
                    </a>
                {% endif %}
            </h1>

            {#
             # A page waiting for a worker has to move on its own. Where the placeholder below is drawn it
             # polls the repository itself; everywhere else the status reloads the page now and then.
             #}
            {% if waiting is not empty %}
                <div class="chart-status"
                     {% if not showSkeleton %}{{ stimulus_controller('refresh', {interval: 30000}) }}{% endif %}>
                    {% for repository in waiting %}
                        <div class="alert alert--info">
                            {% if repository.hasData %}
                                <strong>{{ repository.name }} is being analysed right now.</strong>
                                {{ repository.releaseCount }} of its releases are measured so far - this page
                                updates itself as more of them come in.
                            {% else %}
                                <strong>{{ repository.name }} is queued for analysis.</strong>
                                Every release of it is checked out and measured one by one, which takes a while -
                                this page updates itself as soon as the first numbers are in.
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {#
             # A repository that was just submitted has a chart before it has numbers: the shape of the
             # report is drawn as a placeholder, and the page swaps itself for the real thing as soon as
             # the worker measured the first release.
             #}
            {% if showSkeleton %}
                <div class="section skeleton"
                     {{ stimulus_controller('skeleton', { url: path('repository', {'name': waiting|first.name}) }) }}>
                    <p class="chart-lead">
                        Waiting for the first measured release - this page updates itself as soon as there
                        is one.
                    </p>
                    <div class="panel chart-panel">
                        <div class="skeleton__chart" aria-hidden="true">
                            {% for height in [38, 62, 47, 71, 55, 84, 49, 66, 58, 77, 61, 90] %}
                                <span class="skeleton__bar" style="height: {{ height }}%"></span>
                            {% endfor %}
                        </div>
                    </div>
                    <section class="section">
                        <div class="eyebrow">Release analysis</div>
                        <div class="panel panel--pad-lg" style="margin-top: var(--space-5)">
                            <div class="analysis" aria-hidden="true">
                                {% for group in 1..4 %}
                                    <div>
                                        <div class="analysis__title">
                                            <span class="skeleton__line" style="width: 40%"></span>
                                        </div>
                                        <dl class="analysis__list">
                                            {% for row in 1..3 %}
                                                <div class="analysis__row">
                                                    <dt class="analysis__label">
                                                        <span class="skeleton__line" style="width: {{ 90 + row * 20 }}px"></span>
                                                    </dt>
                                                    <dd class="analysis__value">
                                                        <span class="skeleton__line" style="width: 56px"></span>
                                                    </dd>
                                                </div>
                                            {% endfor %}
                                        </dl>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </section>
                </div>
            {% elseif series is not empty %}
                <div data-controller="chart"
                     data-chart-limit-value="{{ chartLimit }}"
                     data-repositories="{{ series|map(repository => repository.asGraph)|json_encode|e('html_attr') }}">
                    <p class="chart-lead">
                        Average cyclomatic complexity per analysed release.
                        <span data-chart-target="seriesCount"></span>
                    </p>

                    {#
                     # What the chart is drawn from stands above it: everything the report carries can be
                     # added here, whoever owns it - the box is the whole navigation of this screen, and
                     # what is picked ends up in the query string. The headline says what it is, so the
                     # box needs no second one.
                     #}
                    <div class="repository-picker">
                        <select class="js-repository-select" name="repositories[]" multiple="multiple"
                                aria-label="Repositories in this chart" data-chart-target="select">
                            {# no whitespace around the name: select2 renders the raw text into its chips #}
                            {% for repository in selection.options %}
                                <option value="{{ repository.name }}" {{ repository in series ? 'selected="selected"' }}>{{ repository.name }}</option>
                            {% endfor %}
                        </select>
                        <p class="repository-picker__hint">
                            Up to {{ chartLimit }} at a time, one colour each.
                            <a href="{{ path('start') }}">Add a repository</a> the report does not carry yet.
                        </p>
                    </div>

                    <div class="panel chart-panel">
                        <div class="chart-canvas">
                            <canvas data-chart-target="canvas"></canvas>
                        </div>
                    </div>

                    {#
                     # One tab per line of the chart: every repository in it can be read release by
                     # release, not only the one the page was opened with. The tabs are built by the
                     # controller, since what is in the chart changes without leaving the page.
                     #}
                    <section class="section" data-chart-target="release" hidden>
                        <div class="eyebrow">Release analysis</div>
                        <div class="tabs tabs--series" role="tablist" aria-label="Repositories in this chart"
                             data-chart-target="releaseTabs"></div>
                        <div class="release-head">
                            <div>
                                <h2>
                                    <span class="release-head__name" data-chart-target="releaseRepository"></span>
                                    <span class="badge" data-chart-target="releaseName"></span>
                                </h2>
                                <div class="release-head__meta" data-chart-target="releaseMeta"></div>
                            </div>
                            <select class="release-select" aria-label="Release"
                                    data-chart-target="releaseSelect" data-action="chart#selectRelease"></select>
                        </div>
                        <div class="panel panel--pad-lg" role="tabpanel" data-chart-target="releasePanel">
                            <div class="analysis" data-chart-target="analysis"></div>
                        </div>
                    </section>
                </div>
            {% else %}
                <p class="chart-lead empty-state">
                    Nothing measured yet - <a href="{{ path('start') }}">add the first repository</a>.
                </p>
            {% endif %}
        </div>
    </main>
{% endblock %}
